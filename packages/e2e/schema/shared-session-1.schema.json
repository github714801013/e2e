{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2e.dev/schema/shared-session-1.schema.json",
  "title": "e2e shared-session-1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "account", "engine", "platform", "appIdentity", "createdAt", "state"],
  "properties": {
    "schemaVersion": { "const": "shared-session-1" },
    "key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "account": { "type": "string", "minLength": 1, "maxLength": 256 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "spiVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "spiVersion": { "const": 1 }
      }
    },
    "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
    "appIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "algorithm", "iv", "tag", "ciphertext"],
      "properties": {
        "format": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 },
        "algorithm": { "const": "A256GCM" },
        "iv": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$" },
        "ciphertext": {
          "allOf": [
            { "$ref": "#/$defs/base64" },
            { "type": "string", "minLength": 4, "maxLength": 89478488 }
          ]
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "format": "date-time"
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
